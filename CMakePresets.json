{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (Debug + Tests)",
      "description": "Debug build with tests, pybind11, and compile_commands.json for IDE support",
      "binaryDir": "build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_TEST": "ON",
        "COMPILE_URDFApproxGeom_PYBINDING": "ON",
        "ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized Release build with LTO",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_TEST": "OFF",
        "COMPILE_URDFApproxGeom_PYBINDING": "OFF",
        "ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Sanitizers (ASan + UBSan)",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "binaryDir": "build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_TEST": "ON",
        "COMPILE_URDFApproxGeom_PYBINDING": "OFF",
        "ENABLE_SANITIZER": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Code Coverage",
      "description": "Debug build with gcov instrumentation for lcov/gcovr coverage reports",
      "binaryDir": "build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_TEST": "ON",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "research",
      "displayName": "Research (full sphere-tree)",
      "description": "Research edition with sphere_tree backend enabled",
      "binaryDir": "build/research",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_TEST": "ON",
        "COMPILE_URDFApproxGeom_PYBINDING": "ON",
        "URDFApproxGeom_ENABLE_SPHERE_TREE": "ON",
        "URDFApproxGeom_EDITION": "research"
      }
    },
    {
      "name": "commercial",
      "displayName": "Commercial (no sphere-tree)",
      "description": "Commercial edition without sphere_tree backend",
      "binaryDir": "build/commercial",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_TEST": "ON",
        "COMPILE_URDFApproxGeom_PYBINDING": "ON",
        "URDFApproxGeom_ENABLE_SPHERE_TREE": "OFF",
        "URDFApproxGeom_EDITION": "commercial"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "jobs": 0
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "jobs": 0
    },
    {
      "name": "research",
      "configurePreset": "research",
      "jobs": 0
    },
    {
      "name": "commercial",
      "configurePreset": "commercial",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "research",
      "configurePreset": "research",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "commercial",
      "configurePreset": "commercial",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
