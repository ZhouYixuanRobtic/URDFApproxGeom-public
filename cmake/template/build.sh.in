#!/bin/bash

# @PROJECT_NAME@ Build Script for CI
# This script builds the project, creates packages, and moves them to dist/
# Generated by CMake

set -e  # Exit on any error
set -u  # Exit on undefined variables

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Configuration
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="${PROJECT_ROOT}/build"
DIST_DIR="${PROJECT_ROOT}/dist"
BUILD_TYPE="${BUILD_TYPE:-Release}"

# Feature flags (defaults based on project configuration)
ENABLE_PYBINDING="${ENABLE_PYBINDING:-OFF}"
ENABLE_TEST="${ENABLE_TEST:-OFF}"
ENABLE_DOXYGEN="${ENABLE_DOXYGEN:-OFF}"
ENABLE_COVERAGE="${ENABLE_COVERAGE:-OFF}"
ENABLE_CPP_INTERFACE="${ENABLE_CPP_INTERFACE:-ON}"

# Test options
COLORED_TESTS="${COLORED_TESTS:-true}"
GTEST_FILTER="${GTEST_FILTER:-}"

CLEAN_BUILD=false
CLEAN_AFTER_BUILD=false

# Function to cleanup previous builds
cleanup_build() {
    log_info "Cleaning up previous build artifacts..."

    if [ -d "${BUILD_DIR}" ]; then
        rm -rf "${BUILD_DIR}"
        log_success "Removed build directory"
    fi

    # Clean Python build artifacts
    if [ -d "${PROJECT_ROOT}/@PROJECT_NAME@_interface_py.egg-info" ]; then
        rm -rf "${PROJECT_ROOT}/@PROJECT_NAME@_interface_py.egg-info"
        log_success "Removed Python egg-info"
    fi

    # Clean dist directory
    if [ -d "${DIST_DIR}" ]; then
        rm -rf "${DIST_DIR}"
        log_success "Removed dist directory"
    fi
}

# Function to cleanup after build
cleanup_after_build() {
    if [ "${CLEAN_AFTER_BUILD}" = "true" ]; then
        log_info "Cleaning up build artifacts after successful build..."

        if [ -d "${BUILD_DIR}" ]; then
            rm -rf "${BUILD_DIR}"
            log_success "Removed build directory after build"
        fi

        log_info "Build artifacts cleaned up. Only dist/ directory remains."
    fi
}

# Function to cleanup Python egg-info
cleanup_egg_info() {
    log_info "Cleaning up Python egg-info artifacts..."

    if [ -d "${PROJECT_ROOT}/@PROJECT_NAME@_interface_py.egg-info" ]; then
        rm -rf "${PROJECT_ROOT}/@PROJECT_NAME@_interface_py.egg-info"
        log_success "Removed Python egg-info"
    fi
}

# Function to create directories
create_directories() {
    log_info "Creating necessary directories..."

    mkdir -p "${BUILD_DIR}"
    mkdir -p "${DIST_DIR}"

    log_success "Directories created"
}

# Function to build with CMake
build_with_cmake() {
    log_info "Configuring and building with CMake..."

    cd "${BUILD_DIR}"

    # Configure with CMake
    cmake "${PROJECT_ROOT}" \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
        -DENABLE_PYBINDING="${ENABLE_PYBINDING}" \
        -DENABLE_TEST="${ENABLE_TEST}" \
        -DENABLE_DOXYGEN="${ENABLE_DOXYGEN}" \
        -DENABLE_COVERAGE="${ENABLE_COVERAGE}" \
        -DENABLE_CPP_INTERFACE="${ENABLE_CPP_INTERFACE}"

    # Build
    make -j$(nproc)

    log_success "CMake build completed"
}

# Function to run tests
run_tests() {
    log_info "Running tests..."

    cd "${BUILD_DIR}"

    # Build gtest filter args
    local GTEST_ARGS=""
    if [ -n "${GTEST_FILTER}" ]; then
        GTEST_ARGS="--gtest_filter=${GTEST_FILTER}"
        log_info "Filter: ${GTEST_FILTER}"
    fi

    # When filter is set, always use direct binary (colored, filterable).
    # When no filter, prefer colored direct run, fall back to ctest.
    if [ -n "${GTEST_FILTER}" ] || [ "${COLORED_TESTS:-false}" = "true" ]; then
        for test_exec in test/*test_*; do
            if [ -f "$test_exec" ] && [ -x "$test_exec" ]; then
                log_info "Running $(basename $test_exec)..."
                ${test_exec} ${GTEST_ARGS} || {
                    log_error "Some tests failed"
                    exit 1
                }
            fi
        done
    else
        ctest --output-on-failure --verbose || {
            log_error "Some tests failed"
            exit 1
        }
    fi

    log_success "All tests passed"
}

# Function to create Python package
create_python_package() {
    log_info "Creating Python package..."

    cd "${PROJECT_ROOT}"

    # Create Python wheel
    python setup.py bdist_wheel

    # Move wheel to dist directory
    if ls dist/*.whl 1> /dev/null 2>&1; then
        # Check if wheel is already in the target directory
        if [ ! -f "${DIST_DIR}/$(basename $(ls dist/*.whl))" ]; then
            mv dist/*.whl "${DIST_DIR}/"
        fi
        log_success "Python package created: $(basename $(ls ${DIST_DIR}/*.whl))"
    else
        log_error "Failed to create Python package"
        exit 1
    fi
}

# Function to create CPack package
create_cpack_package() {
    log_info "Creating CPack package..."

    cd "${BUILD_DIR}"

    # Create package
    cpack

    # Move package to dist directory
    if ls *.deb 1> /dev/null 2>&1; then
        mv *.deb "${DIST_DIR}/"
        log_success "CPack package created and moved to dist/: $(basename $(ls ${DIST_DIR}/*.deb))"
    elif ls *.tar.gz 1> /dev/null 2>&1; then
        mv *.tar.gz "${DIST_DIR}/"
        log_success "CPack package created and moved to dist/: $(basename $(ls ${DIST_DIR}/*.tar.gz))"
    else
        log_error "Failed to create CPack package"
        exit 1
    fi
}

# Function to verify created packages
verify_packages() {
    log_info "Verifying created packages..."

    # Check for Debian package
    DEB_COUNT=$(find "${DIST_DIR}" -name "*.deb" -type f | wc -l)
    if [ "${DEB_COUNT}" -gt 0 ]; then
        log_success "Found ${DEB_COUNT} Debian package(s)"
        ls -la "${DIST_DIR}"/*.deb
    fi

    # Check for Python wheel
    if [ "${ENABLE_PYBINDING}" = "ON" ]; then
        WHEEL_COUNT=$(find "${DIST_DIR}" -name "*.whl" -type f | wc -l)
        if [ "${WHEEL_COUNT}" -gt 0 ]; then
            log_success "Found ${WHEEL_COUNT} Python wheel(s)"
            ls -la "${DIST_DIR}"/*.whl
        fi
    fi
}

# Main execution
main() {
    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --debug)
                BUILD_TYPE=Debug
                shift
                ;;
            --release)
                BUILD_TYPE=Release
                shift
                ;;
            --relwithdebinfo)
                BUILD_TYPE=RelWithDebInfo
                shift
                ;;
            --clean)
                CLEAN_BUILD=true
                shift
                ;;
            --no-clean)
                CLEAN_BUILD=false
                shift
                ;;
            --clean-after)
                CLEAN_AFTER_BUILD=true
                shift
                ;;
            --no-clean-after)
                CLEAN_AFTER_BUILD=false
                shift
                ;;
            --pybinding)
                ENABLE_PYBINDING=ON
                shift
                ;;
            --no-pybinding)
                ENABLE_PYBINDING=OFF
                shift
                ;;
            --test)
                ENABLE_TEST=ON
                shift
                ;;
            --no-test)
                ENABLE_TEST=OFF
                shift
                ;;
            --doxygen)
                ENABLE_DOXYGEN=ON
                shift
                ;;
            --no-doxygen)
                ENABLE_DOXYGEN=OFF
                shift
                ;;
            --coverage)
                ENABLE_COVERAGE=ON
                shift
                ;;
            --no-coverage)
                ENABLE_COVERAGE=OFF
                shift
                ;;
            --gtest-filter)
                GTEST_FILTER="$2"
                shift 2
                ;;
            --colored-tests)
                COLORED_TESTS=true
                shift
                ;;
            --no-colored-tests)
                COLORED_TESTS=false
                shift
                ;;
            --help)
                echo "Usage: $0 [OPTIONS]"
                echo "Options:"
                echo "  --debug          Build with Debug configuration"
                echo "  --release        Build with Release configuration (default)"
                echo "  --relwithdebinfo Build with RelWithDebInfo configuration"
                echo "  --clean          Clean build directory before building (default)"
                echo "  --no-clean       Skip cleaning build directory before building"
                echo "  --clean-after    Clean build artifacts after successful build (default: false)"
                echo "  --no-clean-after Skip cleaning build artifacts after build"
                echo "  --pybinding      Enable Python binding (default)"
                echo "  --no-pybinding  Disable Python binding"
                echo "  --test           Enable testing (default)"
                echo "  --no-test       Disable testing"
                echo "  --doxygen       Enable Doxygen documentation (default)"
                echo "  --no-doxygen    Disable Doxygen documentation"
                echo "  --coverage       Enable code coverage instrumentation"
                echo "  --no-coverage    Disable code coverage (default)"
                echo "  --gtest-filter FILTER  Run only tests matching GoogleTest filter (e.g. 'MyTest.*')"
                echo "  --colored-tests Enable colored test output (default)"
                echo "  --no-colored-tests Disable colored test output"
                echo "  --help           Show this help message"
                echo ""
                echo "Environment variables:"
                echo "  BUILD_TYPE         Build type (Debug/Release/RelWithDebInfo, default: Release)"
                echo "  ENABLE_PYBINDING   Enable Python binding (ON/OFF, default: OFF)"
                echo "  ENABLE_TEST        Enable testing (ON/OFF, default: OFF)"
                echo "  ENABLE_DOXYGEN     Enable Doxygen documentation (ON/OFF, default: OFF)"
                echo "  ENABLE_COVERAGE    Enable code coverage (ON/OFF, default: OFF)"
                echo "  COLORED_TESTS      Enable colored test output (true/false, default: true)"
                echo ""
                echo "Examples:"
                echo "  $0                    # Clean Release build, keep build artifacts"
                echo "  $0 --debug --test     # Debug build with tests"
                echo "  $0 --release          # Explicit Release build"
                echo "  $0 --clean-after      # Clean before and after build (CI mode)"
                echo "  $0 --no-clean         # Keep previous build, don't clean after"
                echo "  $0 --pybinding --test  # Enable Python binding and testing"
                echo "  $0 --no-pybinding     # Disable Python binding"
                echo "  $0 --test --no-colored-tests # Run tests without colored output"
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    # Log build configuration
    log_info "Starting @PROJECT_NAME@ build process"
    log_info "Project root: ${PROJECT_ROOT}"
    log_info "Build directory: ${BUILD_DIR}"
    log_info "Dist directory: ${DIST_DIR}"
    log_info "Build type: ${BUILD_TYPE}"
    log_info "Python binding: ${ENABLE_PYBINDING}"
    log_info "Testing: ${ENABLE_TEST}"
    log_info "Doxygen documentation: ${ENABLE_DOXYGEN}"
    log_info "Coverage: ${ENABLE_COVERAGE}"
    log_info "Colored tests: ${COLORED_TESTS}"
    log_info "Clean before build: ${CLEAN_BUILD}"
    log_info "Clean after build: ${CLEAN_AFTER_BUILD}"

    # Execute build steps
    if [ "${CLEAN_BUILD}" = "true" ]; then
        cleanup_build
    fi

    create_directories
    build_with_cmake

    # Run tests if enabled
    if [ "${ENABLE_TEST}" = "ON" ]; then
        run_tests
    fi

    create_cpack_package

    # Create Python package if enabled
    if [ "${ENABLE_PYBINDING}" = "ON" ]; then
        create_python_package
    fi

    verify_packages

    # Show build summary
    echo ""
    log_info "Build Summary:"
    echo "=================="
    echo "Build type: ${BUILD_TYPE}"
    echo "Python binding: ${ENABLE_PYBINDING}"
    echo "Testing: ${ENABLE_TEST}"
    echo "Doxygen documentation: ${ENABLE_DOXYGEN}"
    echo "Coverage: ${ENABLE_COVERAGE}"
    echo "Colored tests: ${COLORED_TESTS}"
    echo ""
    echo "Generated packages in ${DIST_DIR}:"
    ls -la "${DIST_DIR}"
    echo ""

    log_success "Build completed successfully!"

    cleanup_after_build

    cleanup_egg_info
}

# Execute main function
main "$@"
