# clang-tidy configuration for C++17 projects.
# Run: clang-tidy -p build/compile_commands.json src/*.cpp
# Or via cmake target: make clang-tidy (from StaticAnalyzers.cmake)
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  performance-*,
  -performance-avoid-endl,
  readability-*,
  -readability-identifier-naming,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  modernize-*,
  -modernize-use-trailing-return-type,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-owning-memory,
  misc-*,
  -misc-include-cleaner,
  -misc-const-correctness,
  portability-*,

CheckOptions:
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true
  - key: readability-function-size.LineThreshold
    value: 80
  - key: readability-function-size.BranchThreshold
    value: 10
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: true
  - key: modernize-use-nullptr.NullPointerConstants
    value: "0;NULL"

FormatStyle: file
HeaderFilterRegex: ".*"
WarningsAsErrors: ""
ExtraArgs: ["-std=c++17"]
